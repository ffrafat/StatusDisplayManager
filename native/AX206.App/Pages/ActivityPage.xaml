<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AX206.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:AX206.Services">

    <Grid Padding="36,24,36,36" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Activity" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="Clear" HorizontalAlignment="Right" Click="Clear_Click" />
        </Grid>
        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" Padding="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView x:Name="LogList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:LogEntry">
                        <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind TimeText}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Tag}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Message}" FontSize="13" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
