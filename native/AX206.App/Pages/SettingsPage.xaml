<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AX206.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <Grid Padding="36,24,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

                <controls:SettingsCard Header="Start with Windows"
                                       Description="Launch quietly to the notification area when you sign in.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggle_Toggled" />
                </controls:SettingsCard>
                <InfoBar x:Name="ElectronWarning" Severity="Warning" IsClosable="False" IsOpen="False"
                         Title="The Electron version also starts with Windows"
                         Message="Only one app can drive the display. Turn off Start with Windows in the Electron version (or uninstall it) so the two don't compete at sign-in." />

                <controls:SettingsCard Header="Connect to the display on start"
                                       Description="Open the AX206 automatically when the app starts.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE88A;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AutoConnectToggle" Toggled="AutoConnectToggle_Toggled" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Keep running when the window is closed"
                                       Description="The display keeps updating from the notification area. Quit from the tray icon.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE737;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="CloseToTrayToggle" Toggled="CloseToTrayToggle_Toggled" />
                </controls:SettingsCard>

                <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,24,0,8" />
                <controls:SettingsCard x:Name="AboutCard" Header="AX206 Display Manager">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/icon.ico" />
                    </controls:SettingsCard.HeaderIcon>
                    <HyperlinkButton Content="Source on GitHub" NavigateUri="https://github.com/ffrafat/StatusDisplayManager" />
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
