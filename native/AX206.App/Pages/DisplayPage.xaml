<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AX206.Pages.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="16" HorizontalAlignment="Left">
            <TextBlock Text="Display" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <!-- Connection card -->
            <Grid Padding="16" CornerRadius="8" BorderThickness="1" ColumnSpacing="16"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{ThemeResource TextFillColorDisabledBrush}" />
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" Text="Disconnected" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StatusDetail" Text="AX206 USB display, 480 × 320" TextWrapping="Wrap" MaxWidth="360"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" MinWidth="110" VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" Click="ConnectButton_Click" />
            </Grid>

            <!-- Live preview inside a device bezel -->
            <Border HorizontalAlignment="Left" Padding="14" CornerRadius="14" BorderThickness="1"
                    Background="#FF14161B" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Border CornerRadius="4">
                    <Image x:Name="PreviewImage" Width="480" Height="320" Stretch="Fill" />
                </Border>
            </Border>

            <!-- Rotation controls -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Previous_Click" ToolTipService.ToolTip="Previous screen" Padding="12,8">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button x:Name="PauseButton" Click="Pause_Click" ToolTipService.ToolTip="Pause rotation"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,8">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                </Button>
                <Button Click="Next_Click" ToolTipService.ToolTip="Next screen" Padding="12,8">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <TextBlock x:Name="RotationText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
