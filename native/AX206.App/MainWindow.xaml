<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AX206.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AX206 Display Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/icon.ico" Width="16" Height="16" />
                <TextBlock Text="AX206 Display Manager" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Display" Tag="display" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="activity">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- Display page -->
                <ScrollViewer x:Name="DisplayPage">
                    <StackPanel Padding="36,24,36,36" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Display" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

                        <!-- Connection card -->
                        <Grid Padding="16" CornerRadius="8" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                         Fill="{ThemeResource TextFillColorDisabledBrush}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock x:Name="StatusTitle" Text="Disconnected" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="StatusDetail" Text="AX206 USB display, 480 × 320"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" MinWidth="110"
                                    Style="{StaticResource AccentButtonStyle}" Click="ConnectButton_Click" />
                        </Grid>

                        <!-- Live preview inside a device bezel -->
                        <Border HorizontalAlignment="Left" Padding="14" CornerRadius="14" BorderThickness="1"
                                Background="#FF14161B" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Border CornerRadius="4">
                                <Image x:Name="PreviewImage" Width="480" Height="320" Stretch="Fill" />
                            </Border>
                        </Border>

                        <!-- Rotation controls -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="Previous_Click" ToolTipService.ToolTip="Previous screen" Padding="12,8">
                                <FontIcon Glyph="&#xE892;" FontSize="14" />
                            </Button>
                            <Button x:Name="PauseButton" Click="Pause_Click" ToolTipService.ToolTip="Pause rotation"
                                    Style="{StaticResource AccentButtonStyle}" Padding="16,8">
                                <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                            </Button>
                            <Button Click="Next_Click" ToolTipService.ToolTip="Next screen" Padding="12,8">
                                <FontIcon Glyph="&#xE893;" FontSize="14" />
                            </Button>
                            <TextBlock x:Name="RotationText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Activity page -->
                <Grid x:Name="ActivityPage" Visibility="Collapsed" Padding="36,24,36,36" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Activity" Style="{StaticResource TitleTextBlockStyle}" />
                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" Padding="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView x:Name="LogList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
