<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>AX206</RootNamespace>
    <AssemblyName>AX206DisplayManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded in the exe, so Explorer and the installer's shortcuts show it -->
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without this, `dotnet publish` of an unpackaged app leaves out the app's .pri and
         compiled XAML (.xbf), and the published exe crashes on start. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0-preview</Version>
    <Product>AX206 Display Manager</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- Windows App SDK components this app never uses. Excluding them keeps ~45 MB of
         AI/ML runtimes (onnxruntime, DirectML) and Search/Widgets out of the install. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.6.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.4" ExcludeAssets="all" />
  </ItemGroup>

  <!-- Debug symbols (libSkiaSharp.pdb alone is 80 MB) are no use in an install. -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedSymbols)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AX206.Core\AX206.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window and tray icon (generated from assets/icon.svg by tools/make-icon.ps1) -->
    <Content Include="..\assets\icon.ico" Link="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
